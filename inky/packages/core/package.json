{
  "name": "@inky/core",
  "version": "0.0.1",
  "description": "Inky's host-agnostic core — reads org GitHub activity and writes the standup. Ships the `inky` CLI (collect/standup/serve) and the collect→reconcile→summarize→render pipeline.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "inky": "./dist/cli.js"
  },
  "//exports": "Built-library exports (dist + .d.ts) so consumers like @perry/core can resolve types and JS without source. Build @inky/core before dependents (the monorepo build is topological). The `inky` bin runs dist/cli.js.",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./config": { "types": "./dist/config.d.ts", "default": "./dist/config.js" },
    "./types": { "types": "./dist/types.d.ts", "default": "./dist/types.js" },
    "./standup": { "types": "./dist/standup.d.ts", "default": "./dist/standup.js" }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "collect": "tsx src/cli.ts collect",
    "standup": "tsx src/cli.ts standup",
    "serve": "tsx src/cli.ts serve",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^21.0.2",
    "croner": "^10.0.1",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.7",
    "picomatch": "^4.0.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
