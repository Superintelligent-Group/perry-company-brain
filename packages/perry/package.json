{
  "name": "@perry/core",
  "version": "0.2.0",
  "description": "Doppel Labs Discord, Notion, and Granola meeting documentation bot",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && pnpm admin:build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p admin/tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "perf:brain": "node scripts/perf-brain.cjs",
    "perf:http": "node scripts/perf-http.cjs",
    "perf:ingestion-queue": "node scripts/perf-ingestion-queue.cjs",
    "graphiti:bridge": "uv run --directory integrations/graphiti python graphiti_bridge.py",
    "graphiti:backfill": "node scripts/graphiti-backfill.cjs",
    "company-brain:gauntlet": "node scripts/company-brain-gauntlet.cjs",
    "company-brain:evaluate": "node scripts/company-brain-evaluate.cjs",
    "company-brain:synthetic": "node scripts/company-brain-synthetic.cjs",
    "lmstudio:smoke": "node scripts/lmstudio-smoke.cjs",
    "together:smoke": "node scripts/together-smoke.cjs",
    "backfill:meetings": "node scripts/backfill-meetings.cjs",
    "start": "node dist/index.js",
    "start:server": "node dist/server/admin-server.js",
    "dev": "tsx watch src/index.ts",
    "dev:server": "tsx watch src/server/admin-server.ts",
    "admin:dev": "vite --config admin/vite.config.ts --host 127.0.0.1",
    "admin:build": "vite build --config admin/vite.config.ts",
    "ops:local-brain-gauntlet": "node scripts/local-brain-gauntlet.cjs",
    "lmstudio:evaluate": "node scripts/lmstudio-extraction-evaluate.cjs",
    "brain:acceptance": "node scripts/brain-acceptance.cjs",
    "sandbox:integrations": "node scripts/sandbox-integrations-check.cjs",
    "brain:scenarios:generate": "node scripts/brain-generate-scenarios.cjs",
    "brain:scenarios:evaluate": "node scripts/brain-evaluate-scenarios.cjs",
    "brain:scenarios:soak": "node scripts/brain-scenario-soak.cjs",
    "company-brain:arcs": "node scripts/company-brain-arcs.cjs",
    "company-brain:scale-matrix": "node scripts/company-brain-scale-matrix.cjs",
    "company-brain:health": "node scripts/company-brain-health.cjs",
    "company-brain:analytics": "node scripts/company-brain-analytics.cjs",
    "company-brain:query": "node scripts/company-brain-query.cjs",
    "company-brain:query-gauntlet": "node scripts/company-brain-query-gauntlet.cjs",
    "company-brain:build-corpus-db": "node scripts/company-brain-build-corpus-db.cjs",
    "company-brain:ontology-gauntlet": "node scripts/company-brain-ontology-gauntlet.cjs",
    "company-brain:ontology-backfill": "node scripts/company-brain-ontology-backfill.cjs",
    "perf:ontology": "node scripts/perf-ontology.cjs",
    "discord:commands:gauntlet": "node scripts/discord-command-gauntlet.cjs",
    "agent-tools:gauntlet": "node scripts/agent-tool-contract-gauntlet.cjs",
    "agent-tools:corpus-gauntlet": "node scripts/agent-tool-corpus-gauntlet.cjs",
    "ontology:repair": "node scripts/ontology-repair.cjs"
  },
  "dependencies": {
    "@ai-sdk/togetherai": "^2.0.53",
    "@notionhq/client": "^5.0.0",
    "ai": "^6.0.197",
    "discord.js": "^14.13.0",
    "lucide-react": "^0.468.0",
    "node-cron": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.0"
  }
}
