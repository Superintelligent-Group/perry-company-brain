# Required when running the Discord worker
DISCORD_TOKEN=
NOTION_TOKEN=

# Editable in the admin UI, but env values still work as defaults/overrides
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_STANDUP_CHANNEL_ID=
DISCORD_MEETING_CHANNEL_ID=
DISCORD_ADMIN_ROLE_IDS=
DISCORD_SANDBOX_CHANNEL_ID=

NOTION_STANDUP_DATA_SOURCE_ID=
NOTION_MEETING_NOTES_DATA_SOURCE_ID=
NOTION_MEETING_NOTES_DATABASE_URL=
NOTION_DECISIONS_DATA_SOURCE_ID=
NOTION_ACTION_ITEMS_DATA_SOURCE_ID=
NOTION_PROJECTS_DATA_SOURCE_ID=

STANDUP_ENABLED=true
STANDUP_TIME=11:45
REMINDER_TIME=09:30
PRE_STANDUP_REMINDER_TIME=11:15
TIMEZONE=America/New_York
STANDUP_FORM_URL=

# Admin/API server
PORT=8787
ADMIN_API_TOKEN=
PERRY_CONFIG_PATH=
PERRY_DB_PATH=
PERRY_SQLITE_JOURNAL_MODE=MEMORY
PERRY_FTS_WORKER=true
PERRY_FTS_INTERVAL_MS=1000
PERRY_FTS_BATCH_SIZE=1000
PERRY_INGESTION_WORKER=false
PERRY_INGESTION_INTERVAL_MS=1000

# Optional temporal knowledge graph sidecar
PERRY_GRAPHITI_ENABLED=false
PERRY_GRAPHITI_BRIDGE_URL=http://127.0.0.1:8791
PERRY_GRAPHITI_GROUP_ID=doppel-labs
PERRY_GRAPHITI_TIMEOUT_MS=120000
PERRY_GRAPHITI_INCLUDE_PRIVATE_NOTES=false
PERRY_GRAPHITI_INCLUDE_TRANSCRIPT=false
# When true, Perry posts typed graphChangeSet operations to /change-sets instead
# of asking Graphiti to re-extract graph facts from the full episode body.
PERRY_GRAPHITI_DIRECT_CHANGESETS=false
PERRY_GRAPH_SYNC_WORKER=false
PERRY_GRAPH_SYNC_INTERVAL_MS=3000
PERRY_GRAPH_SYNC_BATCH_SIZE=10

# Granola ingestion
GRANOLA_MODE=manual
GRANOLA_FOLDER_NAME=
GRANOLA_POLL_INTERVAL_MINUTES=15
PERRY_DEFAULT_PUBLISH_MODE=approval
GRANOLA_API_KEY=
GRANOLA_WEBHOOK_TOKEN=
PERRY_WEBHOOK_MODE=inline

# Required only when running `pnpm graphiti:bridge`
GRAPHITI_BRIDGE_HOST=127.0.0.1
GRAPHITI_BRIDGE_PORT=8791
GRAPHITI_GROUP_ID=doppel-labs
GRAPHITI_TELEMETRY_ENABLED=false
GRAPHITI_LLM_PROVIDER=lmstudio
GRAPHITI_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
GRAPHITI_OPENAI_API_KEY=lm-studio
GRAPHITI_LLM_MODEL=qwen_qwen3-4b-instruct-2507
GRAPHITI_SMALL_LLM_MODEL=qwen_qwen3-4b-instruct-2507
GRAPHITI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
GRAPHITI_EMBEDDING_DIM=768
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# LLM semantic extraction (decisions, action items, entities from a meeting).
# Backend selector: `lmstudio` (default, local OpenAI-compatible endpoint) or
# `together` (Together.ai via the Vercel AI SDK).
PERRY_EXTRACTION_BACKEND=lmstudio
# Together.ai (used when PERRY_EXTRACTION_BACKEND=together). Key lives in AWS
# Secrets Manager at swarm-dev/together-api-key.
TOGETHER_API_KEY=
PERRY_TOGETHER_EXTRACTION_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
PERRY_TOGETHER_EXTRACTION_CONTEXT_CHARS=24000
PERRY_TOGETHER_EXTRACTION_TEMPERATURE=0
# Local LM Studio / OpenAI-compatible endpoint (used when backend=lmstudio).
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
PERRY_LMSTUDIO_EXTRACTION_MODEL=local-model

# Optional local gauntlet switches for exercising the full workflow without
# posting to production systems.
PERRY_DISCORD_DRY_RUN=false
PERRY_NOTION_DRY_RUN=false
